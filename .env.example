# Copy this file to .env and fill in only what you actually use --
# every value below is optional, and Ickle runs fully offline without any
# of them. .env is gitignored, so nothing you put here ever gets committed.

# Hugging Face Hub token. Optional -- raises the (otherwise low,
# unauthenticated) rate limit for dataset/model downloads used by
# src/open_dataset_ingest.py and the vision captioning model
# (src/tools/image_reader.py). Get one at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Anthropic API key. Optional -- only used if you configure Claude as a
# distillation "teacher" model (src/teacher_anthropic.py) for training-data
# generation. Not used anywhere else; irrelevant to normal chat/training.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional cloud-assist bridge (src/cloud_assist.py) -- an explicit,
# user-configured escape hatch to an OpenAI-compatible API, off by default
# and never used unless you set this. ILM_CLOUD_BASE_URL/ILM_CLOUD_ENDPOINT/
# ILM_CLOUD_MODEL are optional overrides (defaults shown).
# ILM_CLOUD_API_KEY=your_api_key_here
# ILM_CLOUD_BASE_URL=https://api.openai.com/v1
# ILM_CLOUD_ENDPOINT=/responses
# ILM_CLOUD_MODEL=gpt-4o-mini

# Other distillation teacher providers (src/trainer_providers.py) each name
# their own env var per provider config rather than a fixed variable here --
# see `python -m src.app trainer-provider --help` to add one and point it
# at whichever env var name you choose.
